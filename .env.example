# ============================================================================
# LM Studio Configuration - Connection to local LM Studio inference server
# ============================================================================
# URL where LM Studio is running (default: http://localhost:1234)
LM_STUDIO_URL=http://localhost:1234
# Model name loaded in LM Studio
LM_STUDIO_MODEL=local-model
# Request timeout in seconds (default: 60)
LM_STUDIO_TIMEOUT=60

# ============================================================================
# RAG Server Configuration - FastAPI server settings
# ============================================================================
# Host to bind to (default: localhost)
RAG_HOST=localhost
# Port to bind to (default: 8000)
RAG_PORT=8000
# Response temperature (0.0-1.0, lower=more deterministic, default: 0.7)
TEMPERATURE=0.7

# ============================================================================
# Vector Database & Embedding Configuration
# ============================================================================
# Embedding model from Hugging Face (cached locally in llmodels/)
# Examples: "all-MiniLM-L6-v2", "paraphrase-multilingual-mpnet-base-v2"
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
# Directory for storing data (sqlite, chunks, etc.)
DATA_DIR=./data

# ============================================================================
# RAG Parameters - Document chunking and retrieval settings
# ============================================================================
# Number of characters per chunk (default: 1800)
CHUNK_SIZE_CHARS=1800
# Number of overlapping characters between chunks (default: 250)
CHUNK_OVERLAP_CHARS=250
# Margin for natural split points (default: 400)
CHUNK_SPLIT_MARGIN=400
# Number of top chunks to retrieve for semantic search (default: 10)
RETRIEVAL_K=10
# Number of top chunks to retrieve for keyword search (default: 15)
KEYWORD_RETRIEVAL_K=15
# Maximum characters to include in context (default: 6000)
MAX_CONTEXT_CHARS=6000
# Maximum chunks returned per source document (default: 4)
MAX_CHUNKS_PER_SOURCE=4
# Weight for semantic similarity in hybrid search (default: 1.0)
SEMANTIC_WEIGHT=1.0
# Weight for keyword matching in hybrid search (default: 2.0)
KEYWORD_WEIGHT=2.0
