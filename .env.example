# ============================================================================
# LM Studio Configuration - Connection to local LM Studio inference server
# ============================================================================
# These seed the initial chat endpoint. Once the server has run, the chat
# endpoint (provider / base URL / model) is editable in the web UI and stored
# in data/settings.json, which then takes precedence over these values.
# Tip: prefer 127.0.0.1 over localhost on Windows (localhost may resolve to
# IPv6 ::1 and read as "offline" if the endpoint only binds IPv4).
#
# URL where the OpenAI-compatible endpoint is running (default: http://localhost:1234)
LM_STUDIO_URL=http://localhost:1234
# Default model id
LM_STUDIO_MODEL=local-model
# Request timeout in seconds (default: 60)
LM_STUDIO_TIMEOUT=60

# ============================================================================
# Image Analysis (for ingesting image files as regular documents)
# ============================================================================
# Vision endpoint for image summaries (default: LM_STUDIO_URL)
IMAGE_VISION_BASE_URL=http://localhost:1234
# Vision model id used for image analysis (default: LM_STUDIO_MODEL)
IMAGE_VISION_MODEL=local-model
# Optional API key for vision endpoint (leave empty for local LM Studio)
IMAGE_VISION_API_KEY=
# Vision request timeout in seconds (default: LM_STUDIO_TIMEOUT)
IMAGE_VISION_TIMEOUT=60
# Max output tokens for the image response (headline + description + bilingual keywords).
# Non-thinking models need ~600; "thinking" models (Qwen3.x, Gemma 4, ...) need ~4000 because
# their reasoning counts against this limit. Disabling thinking in LM Studio is much faster.
IMAGE_VISION_MAX_TOKENS=600
# Longest image side in pixels sent to the vision model (0 = original size)
IMAGE_VISION_MAX_SIDE=1280
# Language of the generated headline and description (keywords are always German + English)
IMAGE_VISION_LANGUAGE=German
# Send date/place/folder hints from the metadata to the vision model as unverified context
IMAGE_VISION_CONTEXT=true
# Skip unchanged images that were already analysed with the same model/prompt/settings
IMAGE_SKIP_ANALYZED=true
# EXIF tags to persist when present (comma-separated, case-sensitive tag names).
# GPS tags use the "GPS:" prefix. Privacy-relevant tags (GPS:*, Artist) are
# deliberately not listed here; add them in your own .env if wanted.
IMAGE_EXIF_FIELDS=ExifImageHeight,ExifImageWidth,Orientation,Make,Model,LensMake,LensModel,FNumber,Flash,ExposureTime,ISOSpeedRatings,FocalLength,FocalLengthIn35mmFilm,ExposureMode,ExposureProgram,SceneCaptureType,SubjectDistance,SubjectDistanceRange,ImageDescription,Software,DateTimeOriginal,OffsetTimeOriginal,SubsecTimeOriginal
# Derive keywords from EXIF (portrait/landscape, year, month, season, camera facing, edited-with, lens/exposure hints)
IMAGE_EXIF_DERIVE_KEYWORDS=true
# Languages of the derived keywords, comma-separated (supported: en, de). Indexing both makes
# keyword matches work whether the question is asked in English or German.
IMAGE_KEYWORD_LANGUAGES=en,de
# Offline place keywords from GPS coordinates (requires GPS tags in IMAGE_EXIF_FIELDS and 'reverse_geocoder')
IMAGE_EXIF_GEOCODE=true
# User-written XMP/IPTC fields to index (merged, de-duplicated, junk-filtered). Supported:
# Title, Description, Keywords, People (face-region names), City, Country, CreatorTool
# (CreatorTool is only used for the "edited with" keyword). Add People in your own .env.
IMAGE_XMP_FIELDS=Title,Description,Keywords,City,Country,CreatorTool
# Exact, case-insensitive title/description/keyword values to discard as junk (comma-separated)
IMAGE_METADATA_IGNORE_VALUES=

# ============================================================================
# OCR (opt-in per database via the "Enable OCR" checkbox in the web UI)
# ============================================================================
# Requires the Tesseract OCR binary installed on the host (not pip-installable, see README).
# Tesseract language string, e.g. "deu+eng" for German + English
OCR_LANGUAGE=deu+eng
# Optional absolute path to tesseract.exe, only needed if it isn't on PATH
OCR_TESSERACT_CMD=

# ============================================================================
# RAG Server Configuration - FastAPI server settings
# ============================================================================
# Host to bind to (default: localhost)
# WARNING: The web UI can ingest and delete files. Do not bind to 0.0.0.0
# unless you know what you are doing.
RAG_HOST=localhost
# Port to bind to (default: 8000)
RAG_PORT=8000
# URL the MCP proxy (rag_mcp_server.py) uses to reach the Filechatter server.
# Only needed if it differs from http://RAG_HOST:RAG_PORT.
#RAG_SERVER_URL=http://localhost:8000
# Response temperature (0.0-1.0, lower=more deterministic, default: 0.7)
TEMPERATURE=0.7

# ============================================================================
# Vector Database & Embedding Configuration
# ============================================================================
# Embedding model from Hugging Face (cached locally in llmodels/)
# Examples: "all-MiniLM-L6-v2", "paraphrase-multilingual-mpnet-base-v2"
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
# Directory for storing data (sqlite, chunks, etc.)
DATA_DIR=./data

# ============================================================================
# RAG Parameters - Document chunking and retrieval settings
# ============================================================================
# Number of characters per chunk (default: 1800)
CHUNK_SIZE_CHARS=1800
# Number of overlapping characters between chunks (default: 250)
CHUNK_OVERLAP_CHARS=250
# Margin for natural split points (default: 400)
CHUNK_SPLIT_MARGIN=400
# Number of top chunks to retrieve for semantic search (default: 10)
RETRIEVAL_K=10
# Number of top chunks to retrieve for keyword search (default: 15)
KEYWORD_RETRIEVAL_K=15
# Maximum characters to include in context (default: 6000)
MAX_CONTEXT_CHARS=6000
# Maximum chunks returned per source document (default: 4)
MAX_CHUNKS_PER_SOURCE=4
# Weight for semantic similarity in hybrid search (default: 1.0)
SEMANTIC_WEIGHT=1.0
# Weight for keyword matching in hybrid search (default: 2.0)
KEYWORD_WEIGHT=2.0
